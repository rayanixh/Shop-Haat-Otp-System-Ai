# =============================================================================
# ShopHaat — Apache / LiteSpeed hardening (root)
#
# Every block is wrapped in <IfModule> so a host that lacks a module ignores the
# rule instead of failing. If your host returns HTTP 500 after uploading this
# file, its AllowOverride does not permit these directives: rename this file to
# .htaccess.off and ask your host to allow "AllowOverride All" for the folder.
# The application itself does not depend on any rule in this file.
# =============================================================================

# Serve a directory request as the front controller, never as a listing.
DirectoryIndex index.php index.html

# --- Directory listings ------------------------------------------------------
<IfModule mod_autoindex.c>
  Options -Indexes
  IndexIgnore *
</IfModule>

# --- Never serve source control metadata -------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule (^|/)\.svn(/|$) - [F,L]
  RewriteRule (^|/)\.hg(/|$) - [F,L]
</IfModule>
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)/\.(git|svn|hg|env)
</IfModule>

# --- Never serve files that can leak data or code ---------------------------
# Logs, SQL dumps, editor backups, lock files, environment files, docs and
# dependency metadata all stay unreadable, whatever directory they sit in.
<FilesMatch "(?i)\.(log|sql|sqlite|db|bak|backup|old|orig|save|swp|swo|tmp|lock|ini|env|sh|bash|dist|md|yml|yaml|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Explicit denials for the application's own sensitive file names.
<FilesMatch "(?i)^(database|installed|config|mail|schema|demo-data)\.(php|lock|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Dotfiles such as .user.ini, .env or .gitignore are configuration, not content.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --- Baseline security headers ----------------------------------------------
# The application also sends these (with a per-request CSP nonce) from PHP.
# Repeating the static ones here protects files served directly by the web
# server, which never reach PHP: CSS, JS, images and uploads.
# No CSP is set here on purpose: the policy contains a per-request nonce that
# only PHP can generate.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), usb=()"
  # X-Frame-Options is deliberately NOT set here: PHP sends it from the
  # "frame-ancestors" value on the admin Security page, so a static value in
  # this file would fight that setting (and the CSP frame-ancestors directive
  # is the modern control anyway). Static assets are not framable content."
  # Never advertise the PHP version.
  Header unset X-Powered-By
</IfModule>

# --- Upload ceiling for mod_php hosts ---------------------------------------
# Mirrors .user.ini (used by PHP-FPM / FastCGI). The application itself adds no
# limit; it reports whatever the server actually allows.
<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 68M
  php_value max_file_uploads 20
  php_flag display_errors off
  php_flag log_errors on
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 68M
  php_value max_file_uploads 20
  php_flag display_errors off
  php_flag log_errors on
</IfModule>
