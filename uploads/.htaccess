# ShopHaat — uploaded files are data, never code.
#
# The upload handler already derives the stored extension from a verified image
# MIME type, so a .php file cannot be uploaded through the application. This is
# defence in depth for anything that ever lands in this folder by other means.
<IfModule mod_autoindex.c>
  Options -Indexes
  IndexIgnore *
</IfModule>

<FilesMatch "(?i)\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh|htaccess|html|htm)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Dotfiles (including this one) are configuration, not content.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"

  # SVG is deliberately not in the deny list above: the installer writes
  # generated .svg placeholders for the demo catalogue, and denying the
  # extension would replace every demo product image with a 403. Customers
  # cannot upload SVG either (sh_upload_image() allowlists the extensions of
  # MIME types getimagesize() recognises, and it does not recognise SVG).
  #
  # Serving one directly would still execute any script inside it, so the
  # response carries its own strict policy: no script, no nested objects, and
  # a sandbox. An <img> tag never runs scripts in the first place.
  <FilesMatch "(?i)\.svg$">
    Header always set Content-Security-Policy "default-src 'none'; script-src 'none'; object-src 'none'; sandbox"
  </FilesMatch>
</IfModule>

# Disable every interpreter that could execute something in this folder.
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar .pl .py .cgi .sh
  RemoveType .php .phtml .phar
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
